# Author(s):
# - Cameron Rutherford <cameron.rutherford@pnnl.gov>

include(CMakeFindDependencyMacro)

if(@HIOP_USE_RESOLVE@ AND NOT TARGET ReSolve::ReSolve)
  find_dependency(ReSolve CONFIG REQUIRED
    HINTS ${ReSolve_DIR} ENV ReSolve_DIR
    PATH_SUFFIXES share/resolve/cmake)
endif()

# Discover MPI on the consumer's system before loading the exported targets.
# Compilers must be selected by the consuming project or a toolchain file,
# never changed by a package configuration after project() has run.
if(@HIOP_USE_MPI@ AND NOT TARGET MPI::MPI_CXX)
  find_dependency(MPI REQUIRED COMPONENTS CXX)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/HiOpTargets.cmake")

# Configure TPLs if not already in an export set

if(@HIOP_USE_RAJA@ AND NOT TARGET OpenMP::OpenMP_CXX)
  find_package(OpenMP)
endif()

# Need to export RAJA and umpire as they have find_package
if(@HIOP_USE_RAJA@ AND NOT TARGET RAJA)
  find_package(RAJA PATHS @RAJA_DIR@)
  find_package(umpire PATHS @umpire_DIR@)
endif()

set(HiOp::SPARSE @HIOP_SPARSE@ CACHE BOOL "indicates if hiop sparse is enabled")

if(@HIOP_USE_GINKGO@ AND NOT TARGET Ginkgo)
  find_package(Ginkgo PATHS @Ginkgo_DIR@)
endif()

if(@HIOP_USE_GPU@)
  if(@HIOP_USE_CUDA@)
    include(CheckLanguage)
    # This must come before enable_language(CUDA)
    set(CMAKE_CUDA_COMPILER @CMAKE_CUDA_COMPILER@)
    enable_language(CUDA)
    check_language(CUDA)
    set(CMAKE_CUDA_FLAGS "@CMAKE_CUDA_FLAGS@")
    find_package(CUDAToolkit REQUIRED)
  elseif(@HIOP_USE_HIP@)
    find_package(hip REQUIRED)
    find_package(hipfft REQUIRED)
    find_package(hiprand REQUIRED)
    find_package(rocrand REQUIRED)
    find_package(hipblas REQUIRED)
    find_package(rocblas REQUIRED)
    find_package(hipcub REQUIRED)
    find_package(rocprim REQUIRED)
    add_definitions(-DHAVE_HIP) # For hipmagma
  endif()
endif()

# See the corresponding build-tree workaround in the top-level CMakeLists.
# Resolve these paths at package-consumption time to keep the installation
# independent of the MPI installation used to build HiOp.
if(@HIOP_USE_MPI@ AND @HIOP_USE_HIP@ AND TARGET HiOp::hiop_tpl)
  set(_hiop_mpi_include_dirs
    ${MPI_CXX_INCLUDE_DIRS}
    ${MPI_CXX_COMPILER_INCLUDE_DIRS}
    ${MPI_CXX_ADDITIONAL_INCLUDE_DIRS}
  )
  list(REMOVE_DUPLICATES _hiop_mpi_include_dirs)
  foreach(_mpi_include_dir IN LISTS _hiop_mpi_include_dirs)
    set_property(TARGET HiOp::hiop_tpl APPEND PROPERTY
      INTERFACE_COMPILE_OPTIONS
      "$<$<COMPILE_LANGUAGE:C,CXX,HIP>:-I${_mpi_include_dir}>"
    )
  endforeach()
  unset(_hiop_mpi_include_dirs)
endif()

# Add HiOp::HiOp alias library
if(@HIOP_BUILD_SHARED@ AND NOT TARGET HiOp::HiOp)
  add_library(HiOp::HiOp ALIAS HiOp::@hiop_default_library_name@)
endif()

if(@HIOP_BUILD_STATIC@ AND NOT TARGET HiOp::HiOp)
  add_library(HiOp::HiOp ALIAS HiOp::@hiop_default_library_name@)
endif()
